# ─── Base de datos ───────────────────────────────────────────────────────────
# Se cambió el puerto de 5432 a 5433 para coincidir con docker-compose.yml
DATABASE_URL="postgresql://caserita:caserita@127.0.0.1:5433/caserita"
# Opcional para migraciones si tu proveedor ofrece una conexión directa.
# DIRECT_URL="postgresql://..."

# ─── App ─────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secretos obligatorios (Genera claves reales para producción con `openssl rand -base64 32`)
SESSION_SECRET="cambia-esto-por-32-caracteres-o-mas-de-verdad"
CRON_SECRET="cambia-esto-tambien"

# ─── Pollar ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY="..."
# Opcional: solo si configuras el webhook de Pollar.
# POLLAR_WEBHOOK_SECRET="genera-un-secreto-de-16-caracteres-o-mas"

# ─── Stellar ─────────────────────────────────────────────────────────────────
STELLAR_NETWORK="testnet"
NEXT_PUBLIC_STELLAR_NETWORK="testnet"

# Cuenta de custodia de la app (Ejecuta: npm run escrow:generar para crear la tuya)
ESCROW_SECRET_KEY="..."
USDC_ISSUER="..."
USDC_CODE="USDC"

# ─── Reglas de producto ──────────────────────────────────────────────────────
MONTO_MAXIMO_USDC="50"
MONTO_MINIMO_USDC="0.1"
HORAS_PARA_ENTREGAR="48"
DIAS_VIGENCIA_TRATO="7"
TIPO_CAMBIO_BS="6.96"

# ─── Modo demo ───────────────────────────────────────────────────────────────
MODO_MOCK="false"
NEXT_PUBLIC_MODO_MOCK="false"
