# ─── Base de datos ───────────────────────────────────────────────────────────
# Local con docker compose:
DATABASE_URL="postgresql://caserita:caserita@localhost:5432/caserita?schema=public"
# Neon / Supabase: pon la url con pooler en DATABASE_URL y la directa en DIRECT_URL.
# DIRECT_URL="postgresql://..."

# ─── App ─────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Genera cada secreto con: openssl rand -base64 32
SESSION_SECRET="cambia-esto-por-32-caracteres-o-mas-de-verdad"
CRON_SECRET="cambia-esto-tambien"

# ─── Pollar ──────────────────────────────────────────────────────────────────
# Dashboard de Pollar -> API keys. La publishable va al cliente; la secreta NO.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY="pub_testnet_..."
POLLAR_SECRET_KEY="sec_testnet_..."
# Los webhooks siguen en "upcoming": si se activan, pon aca su secreto HMAC.
# POLLAR_WEBHOOK_SECRET=""

# ─── Stellar ─────────────────────────────────────────────────────────────────
STELLAR_NETWORK="testnet"
NEXT_PUBLIC_STELLAR_NETWORK="testnet"
# HORIZON_URL="https://horizon-testnet.stellar.org"

# Cuenta de custodia de la app: npm run escrow:generar
ESCROW_SECRET_KEY="S..."
# USDC de Circle. Testnet: GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Mainnet: GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
USDC_ISSUER="GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5"
USDC_CODE="USDC"

# ─── Reglas de producto ──────────────────────────────────────────────────────
MONTO_MAXIMO_USDC="50"
MONTO_MINIMO_USDC="0.1"
HORAS_PARA_ENTREGAR="48"
DIAS_VIGENCIA_TRATO="7"
TIPO_CAMBIO_BS="6.96"

# ─── Modo demo ───────────────────────────────────────────────────────────────
# Simula login y cadena para recorrer el flujo sin claves. Prohibido en produccion.
MODO_MOCK="false"
NEXT_PUBLIC_MODO_MOCK="false"
